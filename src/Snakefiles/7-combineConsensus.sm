#
#  Rule combineConsensus combines the outputs of consensus into a single
#  file, and rename the sequences back to their original names.
#


# combineConsensusI returns DAG-tracked FASTA inputs from the workflow root.
# P and C return FASTA/CRAM paths relative to the selected consensus directory
# for use by the generated shell command.
#
def combineConsensusI(wildcards):
    stage = wildcards.consensus_dir
    return expand(f"{stage}/packages/part{{nnnn}}.fasta", nnnn = glob_wildcards(f"{stage}/packages/part{{xxxx}}.cnspack").xxxx)
def combineConsensusP(wildcards):
    stage = wildcards.consensus_dir
    return expand("packages/part{nnnn}.fasta", nnnn = glob_wildcards(f"{stage}/packages/part{{xxxx}}.cnspack").xxxx)
def combineConsensusC(wildcards):
    stage = wildcards.consensus_dir
    return expand("packages/part{nnnn}.cram", nnnn = glob_wildcards(f"{stage}/packages/part{{xxxx}}.cnspack").xxxx)

def consensusScfmap(wildcards):
    return '10-consensus/unitig-popped.layout.scfmap' if wildcards.consensus_dir == '10-consensus' else '6-layoutContigs/unitig-popped.layout.scfmap'

def consensusPathsTsv(wildcards):
    if wildcards.consensus_dir == '10-consensus':
        return FINAL_PATH_TSV
    return rules.emptyfile.output

def consensusLabel(wildcards, number):
    if wildcards.consensus_dir == '10-consensus':
        return f'8-phasing/label{number}'
    return rules.emptyfile.output

rule combineConsensus:
    input:
        packcns   = combineConsensusI,
        tigmap    = rules.buildPackages.output.tigmap,
        scfmap    = consensusScfmap,
        layout    = consensusLayout,
        ontalns   = rules.generateLayoutContigsInputs.output.ontgapaln if config['withONT'] == "True" else {rules.emptyfile.output},
        hificov   = rules.verkko.input.hifi5cov,
        finished  = rules.buildPackages.output.finished,
        pathstsv  = consensusPathsTsv,
        graph     = rules.verkko.input.graph,
        label1    = lambda wildcards: consensusLabel(wildcards, 1),
        label2    = lambda wildcards: consensusLabel(wildcards, 2)
    output:
        cram      = '{consensus_dir}/unitig-popped.cram',
        crai      = '{consensus_dir}/unitig-popped.cram.crai',
        cns       = '{consensus_dir}/unitig-popped.fasta',
        cnshap1   = '{consensus_dir}/unitig-popped.haplotype1.fasta',
        cnshap2   = '{consensus_dir}/unitig-popped.haplotype2.fasta',
        cnsunas   = '{consensus_dir}/unitig-popped.unassigned.fasta',
        combined  = '{consensus_dir}/combined.fasta'
    log:
        out       = '{consensus_dir}/combineConsensus.out',
        err       = '{consensus_dir}/combineConsensus.err'
    params:
        MASHMAP   = config.get('MASHMAP', "{VERKKO}/bin/mashmap"),
        SAMTOOLS  = config.get('SAMTOOLS', "{VERKKO}/bin/samtools"),
        packcns   = combineConsensusP,
        keepinter = config['keep_intermediate'],
        short_len = config['short_contig_length'],
        screens   = config['screen'],
        packcram  = combineConsensusC,
        haveBAM    = config['withBAM'],
        quick      = isQuickConsensus
    wildcard_constraints:
        consensus_dir = '7-consensus|10-consensus'
    threads:
        8
    resources:
        job_id = 1,
        n_cpus = 8,
        mem_gb = lambda wildcards, input, attempt: getAlignMemoryRequest(attempt, 6, input.packcns),
        time_h = 48
    shell:
        '''
cd {wildcards.consensus_dir}

label1=""
label2=""

if [ -e ../8-phasing/label1 ] ; then label1=`cat ../8-phasing/label1` ; fi
if [ -e ../8-phasing/label2 ] ; then label2=`cat ../8-phasing/label2` ; fi

if [ -s ../{input.label1} ] ; then label1=$(cat ../{input.label1}) ; fi
if [ -s ../{input.label2} ] ; then label2=$(cat ../{input.label2}) ; fi


cat > ./combineConsensus.sh <<EOF
#!/bin/bash
set -e -o pipefail


echo "--------------------"
echo "Combining consensus results."
echo ""

{PYTHON} {VERKKO}/scripts/fasta_combine.py combine combined.fasta \\\\
  ../{input.tigmap} \\\\
  ../{input.scfmap} \\\\
  {params.packcns}

echo "--------------------"
echo "Filtering short/disconnected and contaminants."
echo ""
screen=""
if [ "x{params.screens}" != "x" ]; then
   screen="--contaminant {params.screens} --mashmap {params.MASHMAP}"
fi

{PERL} {VERKKO}/scripts/screen-assembly.pl \\\\
 --assembly      combined.fasta \\\\
 --graph         ../{input.graph} \\\\
 --graphmap      ../{input.scfmap} \\\\
 --hifi-coverage ../{input.hificov} \\\\
 --minlength     {params.short_len} \\\\
 --output        assembly \\\\
 \$screen \\\\
 --threads       {threads} \\\\
> ./screen-assembly.out 2> ./screen-assembly.err

#  Copy the screened assembly to the output.
cp assembly.fasta ../{output.cns}

if [ "{params.haveBAM}" = "True" ] && [ '{params.quick}' != 'True' ]; then
   echo "--------------------"
   echo "Renaming and combining consensus CRAM results."
   echo ""
   mem_per_core=\`(expr \( {resources.mem_gb} \* 70 \) / \( 100 \* {threads} \) | awk '{{if (\$1 < 1) print "1G"; else print \$1"G"}}') || true\`

   {PYTHON} {VERKKO}/scripts/bam_rename.py \\
     ../{input.layout} ../{input.ontalns} ../{input.scfmap} ../{input.tigmap} \\
     {params.packcns} --alignments {params.packcram} \\
   | {params.SAMTOOLS} sort -m \$mem_per_core -@{threads} \\
       -O cram --reference combined.fasta --output-fmt-option embed_ref=1 \\
       -o ../{output.cram}
   {params.SAMTOOLS} index -@{threads} ../{output.cram} ../{output.crai}
else
   touch ../{output.cram}
   touch ../{output.crai}
fi

#  Try to circularize, the script will output to the same file as input since it caches the sequences
#  if it fails to circularize it will output sequence unchanged
for xx in assembly.*.exemplar.fasta ; do
  if [ -e \$xx ]; then
    {PYTHON} {VERKKO}/scripts/circularize_ctgs.py -f 0.65 -p 100 -o \$xx --min-ovl 2500 \$xx
  fi
done

# Stage 7 is the final publisher for an unphased run. In phased runs, keep
# stage-10 auxiliary FASTAs private until finalPhasedAssembly publishes the
# complete deliverable set.
if [ "{wildcards.consensus_dir}" = "7-consensus" ]; then
  for xx in assembly.*.fasta ; do
    if [ -e \$xx ] ; then
      cp \$xx ../\$xx
    fi
  done
fi



if [ x$label1 = x -o x$label2 = x ] ; then
  echo "--------------------"
  echo "No haplotypes supplied, will not extract them from consensus results."
  echo ""

  touch ../{output.cnshap1}
  touch ../{output.cnshap2}
  touch ../{output.cnsunas}

else
  echo "--------------------"
  echo "Finding haplotypes for label1='$label1' and label2='$label2'."
  echo ""

  touch ./paths-haplotype1    #  Because if we don't, the awk below isn't guaranteed
  touch ./paths-haplotype2    #  to make them, and then the extract fails.
  touch ./paths-unassigned

  awk < ../{input.scfmap} \\\\
    'BEGIN {{
       FS="[ \\t]+"; OFS="\\t";
     }}
     (\$1 = "path") && (\$2 ~ /^$label1-[0-9]+$/)    {{ print \$2 > "./paths-haplotype1"; }}
     (\$1 = "path") && (\$2 ~ /^$label2-[0-9]+$/)    {{ print \$2 > "./paths-haplotype2"; }}
     (\$1 = "path") && (\$2 ~ /^unassigned-[0-9]+$/) {{ print \$2 > "./paths-unassigned"; }}'

  echo "--------------------"
  echo "Extracting haplotypes."
  echo ""

  if [ -e ./paths-haplotype1 ] ; then
    {PYTHON} {VERKKO}/scripts/fasta_extract.py extract ../{output.cnshap1} ./paths-haplotype1 ../{output.cns}
  fi
  if [ -e ./paths-haplotype2 ] ; then
    {PYTHON} {VERKKO}/scripts/fasta_extract.py extract ../{output.cnshap2} ./paths-haplotype2 ../{output.cns}
  fi
  if [ -e ./paths-unassigned ] ; then
    {PYTHON} {VERKKO}/scripts/fasta_extract.py extract ../{output.cnsunas} ./paths-unassigned ../{output.cns}
  fi
fi

if [ {params.keepinter} = False ] ; then
  echo "--------------------"
  echo "Removing intermediate files."
  echo ""
  rm -rf packages
fi
EOF

chmod +x ./combineConsensus.sh

./combineConsensus.sh > ../{log.out} 2> ../{log.err}
        '''
