import shlex

# Normalize YAML nulls defensively; the launcher requires both parents before
# it enables this trio-only workflow.
MATERNAL_READS = config.get('MATERNAL_READS') or []
PATERNAL_READS = config.get('PATERNAL_READS') or []


def marker_read_args():
    """Quote repeated read arguments without relying on shell word splitting.

    Child multiplicity must come from the HiFi reads.  The assembly FASTA is
    passed separately as --unitigs only for looking up the retained markers on
    graph nodes; it does not contribute counts or filter marker databases.
    """
    args = []
    for path in HIFI_READS:
        args.extend(['--child', shlex.quote(path)])
    for path in MATERNAL_READS:
        args.extend(['--maternal', shlex.quote(path)])
    for path in PATERNAL_READS:
        args.extend(['--paternal', shlex.quote(path)])
    return ' '.join(args)


# Build regular-space child/parent databases and convert their lookup counts
# to the color table consumed by Rukki.
rule buildParentalMarkers:
    input:
        unitigs = rules.copyFiles.output.unitig_fasta,
        reads = HIFI_READS + MATERNAL_READS + PATERNAL_READS
    output:
        colors = '08-phasing/markers/parental.colors.csv',
        qc = '08-phasing/markers/marker_qc.tsv',
        finished = '08-phasing/markers/markers.finished'
    log:
        err = '08-phasing/markers/build_markers.err'
    params:
        mode = config['phase_mode'],
        k = int(config.get('phase_k', 31)),
        color_fraction = float(config.get('phase_marker_fraction', 0.9)),
        color_minimum = int(config.get('phase_marker_minimum', 100)),
        reads = marker_read_args(),
        meryl = config.get('MERYL', f'{VERKKO}/bin/meryl'),
        lookup = config.get('MERYL_LOOKUP', f'{VERKKO}/bin/meryl-lookup')
    threads:
        int(config['mer_n_cpus'])
    resources:
        job_id = 1,
        n_cpus = int(config['mer_n_cpus']),
        # Counting all child and parental reads in regular space and looking
        # markers up on the assembly needs substantial working memory.
        mem_gb = 128,
        time_h = lambda wildcards, input, attempt: getTimeRequest(attempt, 'mer')
    shell:
        r'''
cd 08-phasing/markers

cat > ./buildParentalMarkers.sh <<EOF
#!/bin/sh
set -e

{VERKKO}/scripts/build_parental_markers.sh \
  --meryl {params.meryl} --lookup {params.lookup} --python '{PYTHON}' \
  --scripts {VERKKO}/scripts --mode {params.mode} --k {params.k} \
  --threads {threads} --out . \
  --color-fraction {params.color_fraction} --color-minimum {params.color_minimum} \
        --unitigs ../../{input.unitigs} \
  {params.reads}
EOF

chmod +x ./buildParentalMarkers.sh
./buildParentalMarkers.sh > ../../{log.err} 2>&1
        '''


# Parental markers name the two partitions; contact evidence extends them to
# unmarked nodes after component-level orientation has been reconciled.
rule fuseParentalContacts:
    input:
        graph = rules.copyFiles.output.unitig_graph,
        parental = rules.buildParentalMarkers.output.colors,
        contacts = rules.hicPhasing.output.hic_binned_unitigs
    output:
        colors = '08-phasing/fused.colors.csv',
        report = '08-phasing/evidence-concordance.tsv',
        conflicts = '08-phasing/evidence-conflicts.tsv'
    log:
        err = '08-phasing/fuse_phasing.err'
    threads:
        int(config['fhc_n_cpus'])
    resources:
        job_id = 1,
        n_cpus = int(config['fhc_n_cpus']),
        mem_gb = lambda wildcards, input, attempt: getMemoryRequest(attempt, 'fhc'),
        time_h = lambda wildcards, input, attempt: getTimeRequest(attempt, 'fhc')
    shell:
        r'''
cd 08-phasing

cat > ./fuse_phasing.sh <<EOF
#!/bin/sh
set -e

{PYTHON} {VERKKO}/scripts/fuse_phase_evidence.py \
  --graph ../{input.graph} --parental ../{input.parental} --contacts ../{input.contacts} \
  --output ../{output.colors} --report ../{output.report} --conflicts ../{output.conflicts}
EOF

chmod +x ./fuse_phasing.sh
./fuse_phasing.sh > ../{log.err} 2>&1
        '''


# Without contact data, parental colors can be walked directly.  With contact
# data this private result is still useful for diagnostics, while runRukkiHIC
# consumes the fused colors for the canonical phase result.
rule runRukkiParents:
    input:
        graph = rules.copyFiles.output.unitig_graph,
        colors = rules.buildParentalMarkers.output.colors
    output:
        tsv = '08-phasing/parental.paths.tsv',
        gaf = '08-phasing/parental.paths.gaf',
        label1 = '08-phasing/parental.label1',
        label2 = '08-phasing/parental.label2'
    log:
        err = '08-phasing/rukki_parental.err'
    threads:
        int(config['ruk_n_cpus'])
    resources:
        job_id = 1,
        n_cpus = int(config['ruk_n_cpus']),
        mem_gb = lambda wildcards, input, attempt: getMemoryRequest(attempt, 'ruk'),
        time_h = lambda wildcards, input, attempt: getTimeRequest(attempt, 'ruk')
    shell:
        r'''
cd 08-phasing

cat > ./rukki_parental.sh <<EOF
#!/bin/sh
set -e

params="--hap-names maternal,paternal --try-fill-bubbles --assign-tangles"
params="\$params --marker-sparsity 3500 --marker-cnt 20 --issue-sparsity 700"
params="\$params --issue-ratio 1 --solid-ratio 1.01 --solid-homozygous-cov-coeff 1.1"
params="\$params --max-homozygous-len 30000000 --trusted-len 325000"

{VERKKO}/bin/rukki trio -g ../{input.graph} -m ../{input.colors}              -p ../{output.tsv} \$params
{VERKKO}/bin/rukki trio -g ../{input.graph} -m ../{input.colors} --gaf-format -p ../{output.gaf} \$params
# Rukki receives maternal,paternal through --hap-names.  Publish paternal as
# Verkko haplotype 1 and maternal as haplotype 2.
echo paternal > ../{output.label1}
echo maternal > ../{output.label2}
EOF

chmod +x ./rukki_parental.sh
./rukki_parental.sh > ../{log.err} 2>&1
        '''
