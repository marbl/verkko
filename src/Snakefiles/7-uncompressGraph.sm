#############################################################################
#
# Restore regular-space node sequences and link CIGARs for ordinary stage-7
# assembly output.  The --paths target bypasses this rule and republishes the
# source assembly.gfa.

GRAPH_UNITIG_SCFMAP = config.get('graph_unitig_scfmap') or '6-layoutContigs/unitig-popped.layout.scfmap'
GRAPH_UNITIG_CONSENSUS = config.get('graph_unitig_consensus') or '7-consensus/combined.fasta'


rule buildUncompressedGraph:
    input:
        scfmap = GRAPH_UNITIG_SCFMAP,
        consensus = GRAPH_UNITIG_CONSENSUS,
        graph = rules.verkko.input.graph,
        hificov = rules.verkko.input.hifi5cov
    output:
        rename_map = '7-consensus/contigs_rename.map',
        unitigs = '7-consensus/unitigs.fasta',
        graph = '7-consensus/assembly.gfa'
    log:
        err = '7-consensus/buildUncompressedGraph.err'
    threads:
        8
    resources:
        job_id = 1,
        n_cpus = 8,
        mem_gb = lambda wildcards, input, attempt: getMemoryRequest(attempt, 'fhc'),
        time_h = lambda wildcards, input, attempt: getTimeRequest(attempt, 'fhc')
    shell:
        r'''
cd 7-consensus

cat > ./buildUncompressedGraph.sh <<EOF
#!/bin/sh
set -e

# Consensus sequence names are path names.  Convert them back to graph-node
# names before alignGFA replaces HPC node sequences and recomputes link CIGARs.
awk 'match(\$1, "path") {{ print \$2"\t"\$3 }}' ../{input.scfmap} \
  > ../{output.rename_map}
{PYTHON} {VERKKO}/scripts/fasta_combine.py rename \
  ../{output.unitigs} ../{output.rename_map} ../{input.consensus}

# Use stable local names so the recorded command is directly reusable from
# this directory and matches the public assembly filenames.
ln -sf ../{input.graph} assembly.homopolymer-compressed.gfa
{VERKKO}/bin/alignGFA \
  -e 0.25 \
  -i assembly.homopolymer-compressed.gfa \
  -T unitigs.fasta 0 \
  -t {threads} \
  -o assembly.gfa

# Add final HiFi RC/ll coverage to the regular-space graph.  The HPC graph
# supplied to alignGFA has no coverage tags.  This graph and
# assembly.homopolymer-compressed.noseq.gfa obtain coverage separately from
# the same stage-5 table.
{PYTHON} {VERKKO}/scripts/inject_coverage.py --allow-absent \
  ../{input.hificov} assembly.gfa \
  > assembly.covered.gfa

mv assembly.covered.gfa assembly.gfa
rm -f assembly.homopolymer-compressed.gfa
EOF

chmod +x ./buildUncompressedGraph.sh
./buildUncompressedGraph.sh > ../{log.err} 2>&1
        '''
