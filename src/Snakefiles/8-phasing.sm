rule runRukkiHIC:
    input:
        graph = '8-phasing/unitigs.hpc.noseq.gfa',
        binning = '8-phasing/fused.colors.csv' if config.get('phase_mode', 'contacts') == 'trio' else '8-phasing/hicverkko.colors.csv'
    output:
        tsv_path = '8-phasing/contact.paths.tsv',
        gaf_path = '8-phasing/contact.paths.gaf',
        label1 = '8-phasing/contact.label1',
        label2 = '8-phasing/contact.label2'
    log:
        err    = '8-phasing/rukki_hic.err'
    threads:
        int(config['fhc_n_cpus'])
    resources:
        job_id = 1,
        n_cpus = int(config['fhc_n_cpus']),
        mem_gb = lambda wildcards, input, attempt: getMemoryRequest(attempt, 'fhc'),
        time_h = lambda wildcards, input, attempt: getTimeRequest(attempt, 'fhc')
    params:
        hap_names = 'maternal,paternal' if config.get('phase_mode', 'contacts') == 'trio' else 'haplotype1,haplotype2',
        label1 = 'paternal' if config.get('phase_mode', 'contacts') == 'trio' else 'haplotype1',
        label2 = 'maternal' if config.get('phase_mode', 'contacts') == 'trio' else 'haplotype2',
        marker_ratio = '5.0' if config.get('phase_mode', 'contacts') == 'trio' else '3.0',
        solid_ratio = '1.01' if config.get('phase_mode', 'contacts') == 'trio' else '1.5'
    shell:
        '''
cd 8-phasing

cat > ./rukki_hic.sh <<EOF
#!/bin/sh
set -e
echo "---Running rukki on the resulting clustering"
params=" --init-assign out_init_ann.csv --refined-assign out_refined_ann.csv --final-assign out_final_ann.csv"
params="\$params --marker-sparsity 5000"
params="\$params --issue-sparsity 1000"
params="\$params --try-fill-bubbles"
params="\$params --fillable-bubble-diff 1000"
params="\$params --fillable-bubble-len 500000"
params="\$params --assign-tangles --tangle-allow-deadend"
