chmod +x ./rukki_hic.sh

./rukki_hic.sh > ../{log.err} 2>&1
        '''


# Every phasing implementation writes private outputs.  Normalize the chosen
# implementation here so scaffolding and consensus are phasing-mode agnostic.
def selectedPhasePaths():
    """Select private phase outputs; downstream rules see only the canonical copy."""
    mode = config.get('phase_mode', 'contacts')
    contacts = config['withHIC'] == 'True' or config['withPOREC'] == 'True'
    # In contact-assisted dual mode, dual chooses the pseudohaplotypes and
    # contacts are consumed only after canonicalization by stage 9.  Check the
    # explicit phase mode first so Hi-C cannot silently replace dual paths.
    if mode == 'dual':
        return ('8-phasing/dual.paths.tsv', '8-phasing/dual.paths.gaf',
                '8-phasing/dual.label1', '8-phasing/dual.label2')
    if contacts:
        return ('8-phasing/contact.paths.tsv', '8-phasing/contact.paths.gaf',
                '8-phasing/contact.label1', '8-phasing/contact.label2')
    if mode == 'trio':
        return ('8-phasing/parental.paths.tsv', '8-phasing/parental.paths.gaf',
                '8-phasing/parental.label1', '8-phasing/parental.label2')
    # The CLI currently enables stage 8 only for a known phase mode, but keep
    # contact paths as the fallback for hand-written configs.
    return ('8-phasing/contact.paths.tsv', '8-phasing/contact.paths.gaf',
            '8-phasing/contact.label1', '8-phasing/contact.label2')


def selectedPhaseColors():
    """Select the color table associated with the chosen phase result."""
    mode = config.get('phase_mode', 'contacts')
    contacts = config['withHIC'] == 'True' or config['withPOREC'] == 'True'
    if mode == 'dual':
        return '8-phasing/dual.colors.csv'
    if mode == 'trio':
        return '8-phasing/fused.colors.csv' if contacts else '8-phasing/markers/parental.colors.csv'
    return '8-phasing/hicverkko.colors.csv'


SELECTED_PHASE_PATHS = selectedPhasePaths()

rule finalizePhasing:
    input:
        tsv = SELECTED_PHASE_PATHS[0],
        gaf = SELECTED_PHASE_PATHS[1],
        label1 = SELECTED_PHASE_PATHS[2],
        label2 = SELECTED_PHASE_PATHS[3],
        colors = selectedPhaseColors()
    output:
        tsv = '8-phasing/rukki.paths.tsv',
        gaf = '8-phasing/rukki.paths.gaf',
        label1 = '8-phasing/label1',
        label2 = '8-phasing/label2',
        colors = '8-phasing/colors.csv'
    log:
        err = '8-phasing/finalize_phasing.err'
    threads:
        int(config['fhc_n_cpus'])
    resources:
        job_id = 1,
        n_cpus = int(config['fhc_n_cpus']),
        mem_gb = lambda wildcards, input, attempt: getMemoryRequest(attempt, 'fhc'),
        time_h = lambda wildcards, input, attempt: getTimeRequest(attempt, 'fhc')
    shell:
        r'''
cd 8-phasing

cat > ./finalize_phasing.sh <<EOF
#!/bin/sh
set -e

cp -p ../{input.tsv} ../{output.tsv}
cp -p ../{input.gaf} ../{output.gaf}
cp -p ../{input.label1} ../{output.label1}
cp -p ../{input.label2} ../{output.label2}
cp -p ../{input.colors} ../{output.colors}
EOF

chmod +x ./finalize_phasing.sh
./finalize_phasing.sh > ../{log.err} 2>&1
        '''
