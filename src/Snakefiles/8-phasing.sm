HIFI_READS = config.get('HIFI_READS') or []
ONT_READS  = config.get('ONT_READS') or []

# Verkko writes an empty YAML sequence as a key with no items, which the YAML
# parser represents as None rather than [].  Contact rules are parsed for all
# stage-8 modes, including --dual, so normalize absent reads to empty lists to
# keep their inactive rule declarations valid.
HIC_READS1 = config.get('HIC_READS1') or []
HIC_READS2 = config.get('HIC_READS2') or []
HAPLO_DIV = float(config.get('haplo_divergence'))
VERKKO = config.get('VERKKO')


rule copyFiles:
    input:
        unitig_fasta = '7-consensus/unitigs.fasta',
        unitig_graph = rules.verkko.input.graph,
        covered_graph = rules.verkko.output.nseqgraph
    log:
        err    = '8-phasing/prepare_hic.err'
    threads:
        int(config['fhc_n_cpus'])
    resources:
        job_id = 1,
        n_cpus = int(config['fhc_n_cpus']),
        mem_gb = lambda wildcards, input, attempt: getMemoryRequest(attempt, 'fhc'),
        time_h = lambda wildcards, input, attempt: getTimeRequest(attempt, 'fhc')
    output:
        unitig_fasta = '8-phasing/unitigs.fasta',
        unitig_hpc = '8-phasing/unitigs.hpc.fasta' ,
        unitig_graph = '8-phasing/unitigs.hpc.noseq.gfa',
        finalnseqgraph = 'assembly.homopolymer-compressed.noseq.gfa'
    shell:
        '''
cd 8-phasing
cat > ./prepare_hic.sh <<EOF
#!/bin/sh
set -e
cp -p ../{input.unitig_fasta} ../{output.unitig_fasta}

awk '/^S/{{print ">"\$2"\\n"\$3}}' ../{input.unitig_graph} > ../{output.unitig_hpc}
# Reuse the stage-7 no-sequence graph, which already contains final HiFi
# coverage.
cp -p ../{input.covered_graph} ../{output.unitig_graph}
cp ../{output.unitig_graph} ../{output.finalnseqgraph}
EOF

chmod +x ./prepare_hic.sh

./prepare_hic.sh > ../{log.err} 2>&1
        '''

rule runMashMap:
    input:
        unitigs_hpc = '8-phasing/unitigs.hpc.fasta',
        unitigs = '8-phasing/unitigs.fasta'
    output:
        unitigs_hpc50 = '8-phasing/unitigs_hpc50.mashmap',
        unitigs_nohpc50 = '8-phasing/unitigs_nonhpc50.mashmap'
    log:
        err    = '8-phasing/run_mashmap.err'
    params:
        MASHMAP   = config.get('MASHMAP', "{VERKKO}/bin/mashmap"),
        MASHMAP_DIV = 100 - 100*float(config['haplo_divergence'])
    threads:
        int(config['fhc_n_cpus'])

    resources:
        job_id = 1,
        n_cpus = int(config['fhc_n_cpus']),
        mem_gb = lambda wildcards, input, attempt: getMemoryRequest(attempt, 'fhc'),
        time_h = lambda wildcards, input, attempt: getTimeRequest(attempt, 'fhc')
    shell:
        '''
cd 8-phasing

cat > ./run_mashmap.sh <<'EOF'
#!/usr/bin/env bash
set -e -o pipefail

echo "---Running MashMap"
bash {VERKKO}/scripts/run_mashmap_filtered.sh \
  {params.MASHMAP} ../{input.unitigs_hpc} ../{input.unitigs_hpc} \
  {threads} {params.MASHMAP_DIV} ../{output.unitigs_hpc50}
bash {VERKKO}/scripts/run_mashmap_filtered.sh \
  {params.MASHMAP} ../{input.unitigs} ../{input.unitigs} \
  {threads} {params.MASHMAP_DIV} ../{output.unitigs_nohpc50}
EOF

chmod +x ./run_mashmap.sh

./run_mashmap.sh > ../{log.err} 2>&1
        '''

#TODO constants to yml
rule prepareScaffolding:
    input:
        unitigs_hpc = '8-phasing/unitigs.hpc.fasta',
        graph_hpc = '8-phasing/unitigs.hpc.noseq.gfa',
        uncompressed_unitigs = '8-phasing/unitigs.fasta',
        rukki_tsv = '8-phasing/rukki.paths.tsv'
    output:
        path_mashmap = '9-scaffolding/paths2ref.mashmap',
        paths_hpc = '9-scaffolding/paths.hpc.fasta',
        ids_list = '9-scaffolding/scaffolding_nodes.list'
    log:
        err    = '9-scaffolding/prepare_ref_mashmap.err'
    params:
        MASHMAP   = config.get('MASHMAP', "{VERKKO}/bin/mashmap"),
        MASHMAP_DIV = 100 - 100*float(config['haplo_divergence']),
        ref = config['ref'] if config['with_ref'] == "True" else '../9-scaffolding/paths.hpc.fasta'
    threads:
        int(config['fhc_n_cpus'])
    resources:
        job_id = 1,
        n_cpus = int(config['fhc_n_cpus']),
        mem_gb = lambda wildcards, input, attempt: getMemoryRequest(attempt, 'fhc'),
        time_h = lambda wildcards, input, attempt: getTimeRequest(attempt, 'fhc')
    shell:
        '''
cd 9-scaffolding

cat > ./prepare_ref_mashmap.sh <<EOF
#!/usr/bin/env bash
set -e
echo "---Preparing rukki paths fasta"
{PYTHON} {VERKKO}/scripts/prepare_scaffolding.py ../{input.rukki_tsv} ../{input.unitigs_hpc} ../{input.graph_hpc} ../{output.paths_hpc} ../{output.ids_list} 20000 5000000 ../{input.uncompressed_unitigs}

echo "---Running MashMap"
bash {VERKKO}/scripts/run_mashmap_filtered.sh \
  {params.MASHMAP} {params.ref} ../{output.paths_hpc} \
  {threads} {params.MASHMAP_DIV} ../{output.path_mashmap}
EOF

chmod +x ./prepare_ref_mashmap.sh

./prepare_ref_mashmap.sh > ../{log.err} 2>&1
        '''
  


rule run_seqtktelo:
    input:
        unitigs = '8-phasing/unitigs.fasta'
    output:
        unitigs_telo = '9-scaffolding/unitigs.telo'
