#############################################################################
#
#  Select the paths used by the final consensus and publish its deliverables.
#  Layout, package creation, per-package consensus and combination are shared
#  with stages 6/7 and are instantiated for 10-consensus by their wildcards.
#

FINAL_CONTACTS = config['withHIC'] == 'True' or config['withPOREC'] == 'True'
FINAL_SCAFFOLD = FINAL_CONTACTS and config.get('phase_scaffold', 'True') == 'True'

# Consensus is phasing-method agnostic.  It consumes either the canonical
# stage-8 interface or the optional stage-9 scaffolded paths.
if FINAL_SCAFFOLD:
    FINAL_PATH_GAF = rules.scaffoldPhasedAssembly.output.final_gaf_path
    FINAL_PATH_TSV = rules.scaffoldPhasedAssembly.output.final_tsv_path
else:
    FINAL_PATH_GAF = rules.finalizePhasing.output.gaf
    FINAL_PATH_TSV = rules.finalizePhasing.output.tsv


# Publish root-level deliverables only after the full stage-10 consensus has
# completed.  As with other Verkko rules, leave an executable script in the
# stage directory so this final copy step is directly reproducible.
rule finalPhasedAssembly:
    input:
        graph      = rules.verkko.input.graph,
        ugraph     = '07-consensus/assembly.gfa',
        nseqgraph  = rules.copyFiles.output.finalnseqgraph,
        layout     = '10-consensus/unitig-popped.layout',
        scfmap     = '10-consensus/unitig-popped.layout.scfmap',
        hificov    = rules.verkko.input.hifi5cov,
        ontcov     = rules.verkko.input.ont5cov,
        cns        = '10-consensus/unitig-popped.fasta',
        cnshap1    = '10-consensus/unitig-popped.haplotype1.fasta',
        cnshap2    = '10-consensus/unitig-popped.haplotype2.fasta',
        cnsunas    = '10-consensus/unitig-popped.unassigned.fasta',
        cram       = '10-consensus/unitig-popped.cram',
        crai       = '10-consensus/unitig-popped.cram.crai',
        pathstsv   = FINAL_PATH_TSV,
        colors     = rules.finalizePhasing.output.colors
    output:
        graph      = 'assembly.homopolymer-compressed.gfa',
        ugraph     = 'assembly.gfa',
        layout     = 'assembly.homopolymer-compressed.layout',
        hificov    = 'assembly.hifi-coverage.csv',
        ontcov     = 'assembly.ont-coverage.csv',
        cns        = 'assembly.fasta',
        cnshap1    = 'assembly.haplotype1.fasta',
        cnshap2    = 'assembly.haplotype2.fasta',
        cnsunas    = 'assembly.unassigned.fasta',
        scfmap     = 'assembly.scfmap',
        pathstsv   = 'assembly.paths.tsv',
        colors     = 'assembly.colors.csv'
    params:
        cram       = 'assembly.cram',
        crai       = 'assembly.cram.crai',
        haveBAM    = config['withBAM']
    log:
        err        = '10-consensus/publishAssembly.err'
    threads:
        int(config['fhc_n_cpus'])
    resources:
        job_id = 1,
        n_cpus = int(config['fhc_n_cpus']),
        mem_gb = lambda wildcards, input, attempt: getMemoryRequest(attempt, 'fhc'),
        time_h = lambda wildcards, input, attempt: getTimeRequest(attempt, 'fhc')
    shell:
        '''
cd 10-consensus

cat > ./publishAssembly.sh <<EOF
#!/bin/sh
set -e

cp -p ../{input.graph}    ../{output.graph}
cp -p ../{input.ugraph}   ../{output.ugraph}
cp -p ../{input.layout}   ../{output.layout}
cp -p ../{input.hificov}  ../{output.hificov}
cp -p ../{input.ontcov}   ../{output.ontcov}
cp -p ../{input.cns}      ../{output.cns}
cp -p ../{input.cnshap1}  ../{output.cnshap1}
cp -p ../{input.cnshap2}  ../{output.cnshap2}
cp -p ../{input.cnsunas}  ../{output.cnsunas}
cp -p ../{input.scfmap}   ../{output.scfmap}
cp -p ../{input.pathstsv} ../{output.pathstsv}
cp -p ../{input.colors}   ../{output.colors}

if [ "{params.haveBAM}" = "True" ]; then
    cp -p ../{input.cram} ../{params.cram}
    cp -p ../{input.crai} ../{params.crai}
fi

for xx in assembly.*.fasta; do
    if [ -e "\$xx" ]; then cp -p "\$xx" ..; fi
done
EOF

chmod +x ./publishAssembly.sh

./publishAssembly.sh > ../{log.err} 2>&1
        '''
