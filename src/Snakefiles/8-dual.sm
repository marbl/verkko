# Dual mode derives homology constraints from MashMap, then runs Rukki dual to
# emit the private paths, colors and labels consumed by stage 8.
rule selectDualHomology:
    input:
        graph = rules.copyFiles.output.unitig_graph,
        mashmap = rules.runMashMap.output.unitigs_hpc50
    output:
        homology = '08-phasing/dual.homology.tsv'
    log:
        err = '08-phasing/select_dual_homology.err'
    threads:
        1
    resources:
        job_id = 1,
        n_cpus = 1,
        mem_gb = lambda wildcards, input, attempt: getMemoryRequest(attempt, 'fhc'),
        time_h = lambda wildcards, input, attempt: getTimeRequest(attempt, 'fhc')
    shell:
        r'''
cd 08-phasing

cat > ./select_dual_homology.sh <<EOF
#!/bin/sh
set -e

{PYTHON} {VERKKO}/scripts/select_dual_homology.py \
  ../{input.graph} ../{input.mashmap} ../{output.homology}
EOF

chmod +x ./select_dual_homology.sh
./select_dual_homology.sh > ../{log.err} 2>&1
        '''


rule runRukkiDual:
    input:
        graph = rules.copyFiles.output.unitig_graph,
        homology = rules.selectDualHomology.output.homology
    output:
        colors = '08-phasing/dual.colors.csv',
        tsv = '08-phasing/dual.paths.tsv',
        gaf = '08-phasing/dual.paths.gaf',
        label1 = '08-phasing/dual.label1',
        label2 = '08-phasing/dual.label2'
    log:
        err = '08-phasing/rukki_dual.err'
    params:
        seed = int(config.get('dual_seed', 1)),
        haploid = '--haploid' if config.get('haploid', 'False') == 'True' else ''
    threads:
        int(config['ruk_n_cpus'])
    resources:
        job_id = 1,
        n_cpus = int(config['ruk_n_cpus']),
        mem_gb = lambda wildcards, input, attempt: getMemoryRequest(attempt, 'ruk'),
        time_h = lambda wildcards, input, attempt: getTimeRequest(attempt, 'ruk')
    shell:
        r'''
cd 08-phasing

cat > ./rukki_dual.sh <<EOF
#!/bin/sh
set -e

{VERKKO}/bin/rukki dual -g ../{input.graph} --homology ../{input.homology} --seed {params.seed} {params.haploid} \
  --colors ../{output.colors} -p ../{output.tsv}
{VERKKO}/bin/rukki dual -g ../{input.graph} --homology ../{input.homology} --seed {params.seed} {params.haploid} \
  --gaf-format -p ../{output.gaf}
echo haplotype1 > ../{output.label1}
echo haplotype2 > ../{output.label2}
EOF

chmod +x ./rukki_dual.sh
./rukki_dual.sh > ../{log.err} 2>&1
        '''
