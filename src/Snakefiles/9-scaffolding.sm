# Contact/reference-assisted scaffolding consumes phased paths from stage 8
# through its canonical interface.  It deliberately does not know whether
# those paths came from trio, contact-only, or dual phasing.

rule scaffoldPhasedAssembly:
    input:
        graph = '08-phasing/unitigs.hpc.noseq.gfa',
        tsv_path = '08-phasing/rukki.paths.tsv',
        gaf_path = '08-phasing/rukki.paths.gaf',
        unitigs_telo = '09-scaffolding/unitigs.telo',
        unitigs_nohpc50 = '08-phasing/unitigs_nonhpc50.mashmap',
        path_mashmap = rules.prepareScaffolding.output.path_mashmap,
        contigs = rules.copyFiles.output.unitig_fasta,
        prefiltered_aln = rules.scaffoldMergeBWA.output.alignments if config['withPOREC'] == "False" else rules.transformBWA.output.byread_mapping
    output:
        scaff_tsv_path = '09-scaffolding/scaff_rukki.paths.tsv',
        scaff_gaf_path = '09-scaffolding/scaff_rukki.paths.gaf',
        final_tsv_path = '09-scaffolding/rukki.paths.tsv',
        final_gaf_path = '09-scaffolding/rukki.paths.gaf'
    params:
        withporec = config['withPOREC']
    log:
        err = '09-scaffolding/scaffolding.err'
    threads:
        int(config['shc_n_cpus'])
    resources:
        job_id = 1,
        n_cpus = int(config['shc_n_cpus']),
        mem_gb = lambda wildcards, input, attempt: getMemoryRequest(attempt, 'shc'),
        time_h = lambda wildcards, input, attempt: getTimeRequest(attempt, 'shc')
    shell:
        r'''
cd 09-scaffolding

cat > ./scaffoldPhasedAssembly.sh <<EOF
#!/bin/sh
set -e

ln -sf ../{input.graph} unitigs.hpc.noseq.gfa
ln -sf ../{input.tsv_path} prescaf_rukki.paths.tsv
ln -sf ../{input.gaf_path} prescaf_rukki.paths.gaf
ln -sf ../{input.unitigs_nohpc50} unitigs_nonhpc50.mashmap
ln -sf ../{input.contigs} unitigs.fasta
if [ "{params.withporec}" = "True" ]; then
    ln -sf ../{input.prefiltered_aln} hic_mapping.byread.output
fi

{PYTHON} {VERKKO}/scripts/launch_scaffolding.py . {params.withporec}

cp scaff_rukki.paths.tsv rukki.paths.tsv
cp scaff_rukki.paths.gaf rukki.paths.gaf
EOF

chmod +x ./scaffoldPhasedAssembly.sh
./scaffoldPhasedAssembly.sh > ../{log.err} 2>&1
        '''
