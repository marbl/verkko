import glob


##########
#
#  Paths to Verkko componenets.
#
#    VERKKO - the root directory of your Verkko installation.
#
#    PYTHON - name of yourpreffered python interpreter, or empty to use
#             whatever is in your environment.
#
VERKKO = config.get('VERKKO', 'please-set-VERKKO-in-config.yml')
PYTHON = config.get('PYTHON', '')
PERL   = config.get('PERL', '')


##########
#
#  Inputs!
#
#  While the shell should expand vars/globs in the input reads, silly
#  advanced users might add those in a hand-generated config file, and
#  so we need to expand wildcards ourself with:
#
#    HIFI_READS  = glob.glob(os.path.expandvars(config['HIFI_READS']))
#    ONT_READS   = glob.glob(os.path.expandvars(config['ONT_READS']))
#
#  But from verkko.sh, we get lists of expanded filenames directly.
#
HIFI_READS = config.get('HIFI_READS')
ONT_READS  = config.get('ONT_READS')
HIC_READS1  = config.get('HIC_READS1')
HIC_READS2  = config.get('HIC_READS2')

PHASE_ENABLED = config.get('phase_enable', 'False') == 'True'
PATHS_SOURCE_UGRAPH = config.get('paths_source_ugraph') or 'emptyfile'
CNSPATH_UGRAPH_OUTPUT = 'assembly.gfa' if config.get('paths_source_ugraph') else '07-consensus/source-assembly.gfa.unavailable'


def pathsSourceUncompressedGraph(wildcards):
    """Use the unchanged source graph for a --paths consensus-only rerun."""
    return PATHS_SOURCE_UGRAPH

# Phased assemblies run a quick consensus in stage 7 to supply sequences for
# phasing, then generate the deliverable consensus in stage 10.  Keep the
# legacy targets available without letting them claim the final filenames.
INITIAL_OUTPUT_PREFIX = '07-consensus/initial-' if PHASE_ENABLED else ''


##########
#
#  Outputs!
#
#  The primary output is 'consensus'.
#
#  The two coverage files are from rule create_final_coverages in the original.
#  Computed here in 5-untip.sm getFinalCoverages
#

rule emptyfile:
    output:   'emptyfile'
    shell:    'touch emptyfile'

rule verkko:
    input:
        graph       = '05-untip/unitig-unrolled-unitig-unrolled-popped-unitig-normal-connected-tip.gfa',
        ugraph      = '07-consensus/assembly.gfa',
        layout      = '06-layoutContigs/unitig-popped.layout',
        scfmap      = '06-layoutContigs/unitig-popped.layout.scfmap',
        cram        = '07-consensus/unitig-popped.cram',
        crai        = '07-consensus/unitig-popped.cram.crai',
        cns         = '07-consensus/unitig-popped.fasta',
       #hifi2cov    = '02-processGraph/unitig-unrolled-hifi-resolved.hifi-coverage.csv',   #  These are generated at the
       #ont2cov     = '02-processGraph/unitig-unrolled-hifi-resolved.ont-coverage.csv',    #  end of untip, but are
       #hifi4cov    = '04-processONT/unitig-unrolled-ont-resolved.hifi-coverage.csv',      #  otherwise unused.
       #ont4cov     = '04-processONT/unitig-unrolled-ont-resolved.ont-coverage.csv',
        hifi5cov    = '05-untip/unitig-unrolled-unitig-unrolled-popped-unitig-normal-connected-tip.hifi-coverage.csv',
        ont5cov     = '05-untip/unitig-unrolled-unitig-unrolled-popped-unitig-normal-connected-tip.ont-coverage.csv'
    output:
        graph       = INITIAL_OUTPUT_PREFIX + 'assembly.homopolymer-compressed.gfa',
        ugraph      = INITIAL_OUTPUT_PREFIX + 'assembly.gfa',
        nseqgraph   = INITIAL_OUTPUT_PREFIX + 'assembly.homopolymer-compressed.noseq.gfa',
        layout      = INITIAL_OUTPUT_PREFIX + 'assembly.homopolymer-compressed.layout',
        hificov     = INITIAL_OUTPUT_PREFIX + 'assembly.hifi-coverage.csv',
        ontcov      = INITIAL_OUTPUT_PREFIX + 'assembly.ont-coverage.csv',
        cns         = INITIAL_OUTPUT_PREFIX + 'assembly.fasta',
        scfmap      = INITIAL_OUTPUT_PREFIX + 'assembly.scfmap'
    params:
        keepinter   = config['keep_intermediate'],
        cram        = INITIAL_OUTPUT_PREFIX + 'assembly.cram',
        crai        = INITIAL_OUTPUT_PREFIX + 'assembly.cram.crai'
    shell:
        '''
#  Stage 7 is always the unphased assembly.  Strip graph sequences and inject
#  coverage here; all phased paths and colors are published from stage 10.
awk < {input.graph} \\
  'BEGIN \\
   {{ \\
     FS="[ \\t]+"; OFS="\\t"; \\
   }} \\
   {{ \\
     if ($1 == "S") {{ \\
       print "S", $2, "*", "LN:i:"length($3); \\
     }} else {{ \\
       print $0; \\
     }} \\
   }}' \\
| \\
{PYTHON} {VERKKO}/scripts/inject_coverage.py --allow-absent \\
  {input.hifi5cov} \\
> {output.nseqgraph}

#  Copy the full assembly to the output directory.

cp -p {input.graph}     {output.graph}
cp -p {input.ugraph}    {output.ugraph}
cp -p {input.layout}    {output.layout}
cp -p {input.cns}       {output.cns}
cp -p {input.hifi5cov}  {output.hificov}
cp -p {input.ont5cov}   {output.ontcov}
cp -p {input.scfmap}    {output.scfmap}

if [ -s {input.cram} ]; then
   cp -p {input.cram} {params.cram}
   cp -p {input.crai} {params.crai}
fi

#  Clean up intermediate files.

if [ {params.keepinter} = "False" ] ; then
  rm -rf 03-align/split
fi
        '''


rule cnspath:
    input:
        graph       = '05-untip/unitig-unrolled-unitig-unrolled-popped-unitig-normal-connected-tip.gfa',
        ugraph      = pathsSourceUncompressedGraph,
        hifi5cov    = '05-untip/unitig-unrolled-unitig-unrolled-popped-unitig-normal-connected-tip.hifi-coverage.csv',
        ont5cov     = '05-untip/unitig-unrolled-unitig-unrolled-popped-unitig-normal-connected-tip.ont-coverage.csv',
        layout      = '06-layoutContigs/unitig-popped.layout',
        scfmap      = '06-layoutContigs/unitig-popped.layout.scfmap',
        consensus   = '07-consensus/unitig-popped.fasta',
        cram        = '07-consensus/unitig-popped.cram',
        crai        = '07-consensus/unitig-popped.cram.crai',
        cnshap1     = '07-consensus/unitig-popped.haplotype1.fasta',
        cnshap2     = '07-consensus/unitig-popped.haplotype2.fasta',
        cnsunas     = '07-consensus/unitig-popped.unassigned.fasta'
    output:
        graph       = '07-consensus/initial-cnspath.assembly.homopolymer-compressed.gfa' if PHASE_ENABLED else 'assembly.homopolymer-compressed.gfa',
        ugraph      = CNSPATH_UGRAPH_OUTPUT,
        hificov     = '07-consensus/initial-cnspath.assembly.hifi-coverage.csv' if PHASE_ENABLED else 'assembly.hifi-coverage.csv',
        ontcov      = '07-consensus/initial-cnspath.assembly.ont-coverage.csv' if PHASE_ENABLED else 'assembly.ont-coverage.csv',
        layout      = '07-consensus/initial-cnspath.assembly.homopolymer-compressed.layout' if PHASE_ENABLED else 'assembly.homopolymer-compressed.layout',
        consensus   = '07-consensus/initial-cnspath.assembly.fasta' if PHASE_ENABLED else 'assembly.fasta',
        scfmap      = '07-consensus/initial-cnspath.assembly.scfmap' if PHASE_ENABLED else 'assembly.scfmap'
    params:
        cnshap1     = '07-consensus/initial-cnspath.assembly.haplotype1.fasta' if PHASE_ENABLED else 'assembly.haplotype1.fasta',    #  Actually, these are optional outputs.
        cnshap2     = '07-consensus/initial-cnspath.assembly.haplotype2.fasta' if PHASE_ENABLED else 'assembly.haplotype2.fasta',
        cnsunas     = '07-consensus/initial-cnspath.assembly.unassigned.fasta' if PHASE_ENABLED else 'assembly.unassigned.fasta',
        cram        = '07-consensus/initial-cnspath.assembly.cram' if PHASE_ENABLED else 'assembly.cram',
        crai        = '07-consensus/initial-cnspath.assembly.cram.crai' if PHASE_ENABLED else 'assembly.cram.crai'
    shell:
        '''
cp -p {input.graph}     {output.graph}
if [ "{input.ugraph}" = "emptyfile" ]; then
  touch {output.ugraph}
else
  cp -p {input.ugraph} {output.ugraph}
fi
cp -p {input.layout}    {output.layout}
cp -p {input.hifi5cov}  {output.hificov}
cp -p {input.ont5cov}   {output.ontcov}
cp -p {input.consensus} {output.consensus}
if [  -s {input.cnshap1} -a -s {input.cnshap2} ]; then
  cp -p {input.cnshap1}   {params.cnshap1}
  cp -p {input.cnshap2}   {params.cnshap2}
fi
if [ -s {input.cram} ]; then
   cp -p {input.cram} {params.cram}
   cp -p {input.crai} {params.crai}
fi
cp -p {input.cnsunas}   {params.cnsunas}
cp -p {input.scfmap}    {output.scfmap}
        '''

##########
#
#  Local rules.
#
#  If your head node allows I/O tasks, include some of the following tasks
#  as local, to run them on the head node directly, instead of submitting
#  a job to the grid:
#
#    splitONT          - partitions ONT reads for alignment to the
#                        initial graph.
#
#    combineONT        - collects results of ONT-to-graph alignments.
#
#    buildPackages     - collects reads for contig consensus.  uses
#                        lots of memory but does no compute, except for
#                        sequence compression/decompression.
#
#    combineConsensus  - collects results of contig consensus computations.
#
#    configureOverlaps - runs a Canu binary to load read lengths and decide
#                        on batche sizes to compute overlaps.
#
localrules: verkko, correctHiFi, configureFindErrors, cnspath, emptyfile



##########
#
#  Rules.
#
include: 'Snakefiles/functions.sm'

include: 'Snakefiles/c1-buildStore.sm'
include: 'Snakefiles/c2-findOverlaps.sm'
include: 'Snakefiles/c4-findErrors.sm'

include: 'Snakefiles/1-buildGraph.sm'
include: 'Snakefiles/2-processGraph.sm'
include: 'Snakefiles/3-splitONT.sm'
include: 'Snakefiles/3-alignONT.sm'
include: 'Snakefiles/3-combineONT.sm'
include: 'Snakefiles/3-alignTips.sm'
include: 'Snakefiles/4-processONT.sm'
include: 'Snakefiles/5-untip.sm'
include: 'Snakefiles/6-layoutContigs.sm'
include: 'Snakefiles/7-extractONT.sm'
include: 'Snakefiles/7-buildPackage.sm'
include: 'Snakefiles/7-generateConsensus.sm'
include: 'Snakefiles/7-combineConsensus.sm'
include: 'Snakefiles/7-uncompressGraph.sm'

if config.get('phase_enable', 'False') == 'True':
    include: 'Snakefiles/8-phasing.sm'

if config.get('phase_mode', 'none') == 'trio':
    include: 'Snakefiles/8-parentalMarkers.sm'

if config.get('phase_mode', 'none') == 'dual':
    include: 'Snakefiles/8-dual.sm'

if config['withHIC'] == "True" or config['withPOREC'] == 'True':
    include: 'Snakefiles/9-scaffolding.sm'

if PHASE_ENABLED:
    include: 'Snakefiles/10-consensus.sm'
